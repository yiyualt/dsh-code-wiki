{
  "name": "dsh-code-wiki",
  "version": "0.15.2",
  "description": "A repository wiki panel for DeepSeek Harness.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "src/architecture.js",
    "src/wiki-document.js",
    "src/wiki-file-tables.js",
    "src/wiki-walkthrough-data.js",
    "src/wiki-editor.js",
    "src/repository-tools.js",
    "src/configured-model.js",
    "src/model-response.js",
    "src/generate-wiki.js",
    "src/github-source.js",
    "src/local-source.js",
    "src/wiki-storage.js",
    "src/wiki-checkpoint.js",
    "src/wiki-progress.js",
    "src/video-api.js",
    "src/video-director.js",
    "src/video-evidence.js",
    "src/video-plan.js",
    "src/video-speech.js",
    "src/video-tempo.js",
    "src/video-storage.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test",
    "check:package": "node scripts/check-package.mjs",
    "check": "npm test && npm run build && npm run check:package"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
