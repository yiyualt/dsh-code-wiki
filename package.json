{
  "name": "dsh-code-wiki",
  "version": "0.30.1",
  "description": "A repository wiki panel for DeepSeek Harness.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/wiki-author.js",
    "src/wiki-storage.js",
    "skills/repo-design-wiki"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "check": "npm run build && node --check client.js && node -e \"import('./index.js')\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "mdast-util-from-markdown": "2.0.3"
  }
}
